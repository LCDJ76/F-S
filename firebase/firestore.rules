rules_version = '2';

// Règles simples adaptées à un outil interne à 2 comptes connus.
// Tout utilisateur connecté (theo ou nicolas) peut lire/écrire.
// La vraie barrière est Firebase Auth : sans compte, on ne rentre pas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
